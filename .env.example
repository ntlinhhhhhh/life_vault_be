API_GATEWAY_APPLICATION_NAME=api-gateway
AUTH_SERVICE_APPLICATION_NAME=auth-service
VAULT_SERVICE_APPLICATION_NAME=vault-service
AUTH_SERVICE_URL=http://localhost:5001
VAULT_SERVICE_URL=http://localhost:5002

# MariaDB database used by auth-service and vault-service.
DB_NAME=life_vault_db
DB_HOST=localhost
DB_PORT=3306
DB_DRIVER=org.mariadb.jdbc.Driver
DB_URL=jdbc:mariadb://localhost:3306/life_vault_db?createDatabaseIfNotExist=true&useSsl=false&gssapiMechanisms=none
DB_USERNAME=root
DB_PASSWORD=change-me

REDIS_HOST=localhost
REDIS_PORT=6379

# Local S3-compatible storage for vault-service file uploads.
# MinIO API avoids port 9000 because api-gateway already uses that port.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101

VAULT_STORAGE_TYPE=s3
VAULT_STORAGE_ROOT=./storage/vault-files
VAULT_S3_ENDPOINT=http://localhost:9100
VAULT_S3_BUCKET=life-vault-files
VAULT_S3_ACCESS_KEY=minioadmin
VAULT_S3_SECRET_KEY=change-me-minio-password

# Keep validate after applying db/init/001_init_schema.sql.
JPA_DDL_AUTO=validate
JPA_OPEN_IN_VIEW=false
SQL_INIT_MODE=never

# Auth-service security settings.
AUTH_JWT_SECRET=replace-with-at-least-64-random-characters
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REAUTH_TOKEN_TTL_SECONDS=300
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_MAX_FAILED_LOGIN_COUNT=5
AUTH_LOCK_DURATION_MINUTES=15
