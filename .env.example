API_GATEWAY_APPLICATION_NAME=api-gateway
AUTH_SERVICE_APPLICATION_NAME=auth-service
VAULT_SERVICE_APPLICATION_NAME=vault-service

# MySQL database used by auth-service and vault-service.
DB_NAME=life_vault_db
DB_HOST=localhost
DB_PORT=3306
DB_URL=jdbc:mysql://localhost:3306/life_vault_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change-me

# Keep validate after applying db/init/001_init_schema.sql.
JPA_DDL_AUTO=validate
JPA_OPEN_IN_VIEW=false
SQL_INIT_MODE=never
